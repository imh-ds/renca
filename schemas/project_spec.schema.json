{
  "$defs": {
    "AuditSpec": {
      "additionalProperties": false,
      "properties": {
        "minimum_clusters": {
          "default": 20,
          "minimum": 1,
          "title": "Minimum Clusters",
          "type": "integer"
        },
        "minimum_rows_per_inference_fold": {
          "default": 100,
          "minimum": 1,
          "title": "Minimum Rows Per Inference Fold",
          "type": "integer"
        }
      },
      "title": "AuditSpec",
      "type": "object"
    },
    "CalibrationSpec": {
      "additionalProperties": false,
      "description": "Optional immutable calibration profile required for hard certification.",
      "properties": {
        "profile_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        }
      },
      "title": "CalibrationSpec",
      "type": "object"
    },
    "DesignSpec": {
      "additionalProperties": false,
      "description": "Declared sampling design metadata.",
      "properties": {
        "cluster_id_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id Column"
        },
        "sampling_unit": {
          "$ref": "#/$defs/SamplingUnit"
        }
      },
      "required": [
        "sampling_unit"
      ],
      "title": "DesignSpec",
      "type": "object"
    },
    "LossName": {
      "description": "Losses supported by the first confirmatory engine.",
      "enum": [
        "squared",
        "brier"
      ],
      "title": "LossName",
      "type": "string"
    },
    "MeasurementLevel": {
      "enum": [
        "continuous",
        "bounded_composite",
        "ordinal_item"
      ],
      "title": "MeasurementLevel",
      "type": "string"
    },
    "MissingDataPolicy": {
      "description": "Predeclared policy for handling missing observations.",
      "enum": [
        "complete_case",
        "multiple_imputation",
        "model_based"
      ],
      "title": "MissingDataPolicy",
      "type": "string"
    },
    "NodeSpec": {
      "additionalProperties": false,
      "description": "Target-specific outcome, loss, and practical-resolution settings.",
      "properties": {
        "continuous_approximation": {
          "default": false,
          "title": "Continuous Approximation",
          "type": "boolean"
        },
        "delta": {
          "exclusiveMinimum": 0,
          "title": "Delta",
          "type": "number"
        },
        "loss": {
          "$ref": "#/$defs/LossName"
        },
        "max_boundary_mass": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Boundary Mass",
          "type": "number"
        },
        "measurement_level": {
          "$ref": "#/$defs/MeasurementLevel",
          "default": "continuous"
        },
        "minimum_distinct_values": {
          "const": 5,
          "default": 5,
          "title": "Minimum Distinct Values",
          "type": "integer"
        },
        "minimum_standard_deviation": {
          "default": 1e-08,
          "minimum": 0,
          "title": "Minimum Standard Deviation",
          "type": "number"
        },
        "node_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Node Id",
          "type": "string"
        },
        "outcome_type": {
          "$ref": "#/$defs/OutcomeType"
        },
        "scale_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale Max"
        },
        "scale_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale Min"
        }
      },
      "required": [
        "node_id",
        "outcome_type",
        "loss",
        "delta"
      ],
      "title": "NodeSpec",
      "type": "object"
    },
    "OutcomeType": {
      "description": "Outcome types supported by the first confirmatory engine.",
      "enum": [
        "continuous",
        "binary"
      ],
      "title": "OutcomeType",
      "type": "string"
    },
    "SamplingUnit": {
      "description": "Sampling-unit declaration used by the later audit stage.",
      "enum": [
        "iid",
        "clustered"
      ],
      "title": "SamplingUnit",
      "type": "string"
    },
    "ScreeningSpec": {
      "additionalProperties": false,
      "properties": {
        "max_neighbors": {
          "default": 10,
          "minimum": 1,
          "title": "Max Neighbors",
          "type": "integer"
        },
        "max_separator_size": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Separator Size",
          "type": "integer"
        },
        "separators_per_pair": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Separators Per Pair",
          "type": "integer"
        }
      },
      "title": "ScreeningSpec",
      "type": "object"
    },
    "SplitSpec": {
      "additionalProperties": false,
      "description": "Predeclared outer-split and inference-fold settings.",
      "properties": {
        "inference_folds": {
          "default": 5,
          "minimum": 2,
          "title": "Inference Folds",
          "type": "integer"
        },
        "selection_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Selection Fraction",
          "type": "number"
        },
        "stratification_columns": {
          "items": {
            "type": "string"
          },
          "title": "Stratification Columns",
          "type": "array"
        }
      },
      "title": "SplitSpec",
      "type": "object"
    },
    "VimpSpec": {
      "additionalProperties": false,
      "description": "Estimator configuration; every field is fingerprinted by the calibration gate.\n\nThe two `nested_safeguard_*` fields govern the specification section 16.4 nested\nlearner safeguard. They belong here rather than in a runtime option precisely because\nthey change the decision rule: altering either one changes `vimp_fingerprint`, which\nmakes every existing calibration profile a visible mismatch until it is revalidated.",
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Confidence Level",
          "type": "number"
        },
        "forest_max_depth": {
          "default": 5,
          "minimum": 1,
          "title": "Forest Max Depth",
          "type": "integer"
        },
        "forest_trees": {
          "default": 100,
          "minimum": 10,
          "title": "Forest Trees",
          "type": "integer"
        },
        "learner_library_version": {
          "default": "v2_quadratic_ridge",
          "enum": [
            "v2_quadratic_ridge",
            "v3_nested_blend"
          ],
          "title": "Learner Library Version",
          "type": "string"
        },
        "nested_safeguard_fold_fraction": {
          "default": 0.8,
          "exclusiveMinimum": 0.5,
          "maximum": 1,
          "title": "Nested Safeguard Fold Fraction",
          "type": "number"
        },
        "nested_safeguard_materiality_z": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "title": "Nested Safeguard Materiality Z",
          "type": "number"
        },
        "ridge_alpha": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Ridge Alpha",
          "type": "number"
        }
      },
      "title": "VimpSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Predeclared configuration required before an analysis can start.",
  "properties": {
    "analysis_id": {
      "format": "uuid",
      "title": "Analysis Id",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/AuditSpec"
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationSpec"
    },
    "design": {
      "$ref": "#/$defs/DesignSpec"
    },
    "missing_data_policy": {
      "$ref": "#/$defs/MissingDataPolicy"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeSpec"
      },
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "preanalysis_reference": {
      "minLength": 1,
      "title": "Preanalysis Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "1.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "screening": {
      "$ref": "#/$defs/ScreeningSpec"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SplitSpec"
    },
    "vimp": {
      "$ref": "#/$defs/VimpSpec"
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "preanalysis_reference",
    "seed",
    "missing_data_policy",
    "design",
    "nodes"
  ],
  "title": "ProjectSpec",
  "type": "object"
}
