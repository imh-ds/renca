{
  "$defs": {
    "AuditSpec": {
      "additionalProperties": false,
      "properties": {
        "minimum_clusters": {
          "default": 20,
          "minimum": 1,
          "title": "Minimum Clusters",
          "type": "integer"
        },
        "minimum_rows_per_inference_fold": {
          "default": 100,
          "minimum": 1,
          "title": "Minimum Rows Per Inference Fold",
          "type": "integer"
        }
      },
      "title": "AuditSpec",
      "type": "object"
    },
    "DesignSpec": {
      "additionalProperties": false,
      "description": "Declared sampling design metadata.",
      "properties": {
        "cluster_id_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id Column"
        },
        "sampling_unit": {
          "$ref": "#/$defs/SamplingUnit"
        }
      },
      "required": [
        "sampling_unit"
      ],
      "title": "DesignSpec",
      "type": "object"
    },
    "LossName": {
      "description": "Losses supported by the first confirmatory engine.",
      "enum": [
        "squared",
        "brier"
      ],
      "title": "LossName",
      "type": "string"
    },
    "MissingDataPolicy": {
      "description": "Predeclared policy for handling missing observations.",
      "enum": [
        "complete_case",
        "multiple_imputation",
        "model_based"
      ],
      "title": "MissingDataPolicy",
      "type": "string"
    },
    "NodeSpec": {
      "additionalProperties": false,
      "description": "Target-specific outcome, loss, and practical-resolution settings.",
      "properties": {
        "delta": {
          "exclusiveMinimum": 0,
          "title": "Delta",
          "type": "number"
        },
        "loss": {
          "$ref": "#/$defs/LossName"
        },
        "minimum_standard_deviation": {
          "default": 1e-08,
          "minimum": 0,
          "title": "Minimum Standard Deviation",
          "type": "number"
        },
        "node_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Node Id",
          "type": "string"
        },
        "outcome_type": {
          "$ref": "#/$defs/OutcomeType"
        }
      },
      "required": [
        "node_id",
        "outcome_type",
        "loss",
        "delta"
      ],
      "title": "NodeSpec",
      "type": "object"
    },
    "OutcomeType": {
      "description": "Outcome types supported by the first confirmatory engine.",
      "enum": [
        "continuous",
        "binary"
      ],
      "title": "OutcomeType",
      "type": "string"
    },
    "SamplingUnit": {
      "description": "Sampling-unit declaration used by the later audit stage.",
      "enum": [
        "iid",
        "clustered"
      ],
      "title": "SamplingUnit",
      "type": "string"
    },
    "ScreeningSpec": {
      "additionalProperties": false,
      "properties": {
        "max_neighbors": {
          "default": 10,
          "minimum": 1,
          "title": "Max Neighbors",
          "type": "integer"
        },
        "max_separator_size": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Separator Size",
          "type": "integer"
        },
        "separators_per_pair": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Separators Per Pair",
          "type": "integer"
        }
      },
      "title": "ScreeningSpec",
      "type": "object"
    },
    "SplitSpec": {
      "additionalProperties": false,
      "description": "Predeclared outer-split and inference-fold settings.",
      "properties": {
        "inference_folds": {
          "default": 5,
          "minimum": 2,
          "title": "Inference Folds",
          "type": "integer"
        },
        "selection_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Selection Fraction",
          "type": "number"
        },
        "stratification_columns": {
          "items": {
            "type": "string"
          },
          "title": "Stratification Columns",
          "type": "array"
        }
      },
      "title": "SplitSpec",
      "type": "object"
    },
    "VimpSpec": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Confidence Level",
          "type": "number"
        },
        "forest_max_depth": {
          "default": 5,
          "minimum": 1,
          "title": "Forest Max Depth",
          "type": "integer"
        },
        "forest_trees": {
          "default": 100,
          "minimum": 10,
          "title": "Forest Trees",
          "type": "integer"
        },
        "ridge_alpha": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Ridge Alpha",
          "type": "number"
        }
      },
      "title": "VimpSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Predeclared configuration required before an analysis can start.",
  "properties": {
    "analysis_id": {
      "format": "uuid",
      "title": "Analysis Id",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/AuditSpec"
    },
    "design": {
      "$ref": "#/$defs/DesignSpec"
    },
    "missing_data_policy": {
      "$ref": "#/$defs/MissingDataPolicy"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeSpec"
      },
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "preanalysis_reference": {
      "minLength": 1,
      "title": "Preanalysis Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "screening": {
      "$ref": "#/$defs/ScreeningSpec"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SplitSpec"
    },
    "vimp": {
      "$ref": "#/$defs/VimpSpec"
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "preanalysis_reference",
    "seed",
    "missing_data_policy",
    "design",
    "nodes"
  ],
  "title": "ProjectSpec",
  "type": "object"
}
