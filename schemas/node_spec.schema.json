{
  "$defs": {
    "LossName": {
      "description": "Losses supported by the first confirmatory engine.",
      "enum": [
        "squared",
        "brier"
      ],
      "title": "LossName",
      "type": "string"
    },
    "MeasurementLevel": {
      "enum": [
        "continuous",
        "bounded_composite",
        "ordinal_item"
      ],
      "title": "MeasurementLevel",
      "type": "string"
    },
    "OutcomeType": {
      "description": "Outcome types supported by the first confirmatory engine.",
      "enum": [
        "continuous",
        "binary"
      ],
      "title": "OutcomeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Target-specific outcome, loss, and practical-resolution settings.",
  "properties": {
    "continuous_approximation": {
      "default": false,
      "title": "Continuous Approximation",
      "type": "boolean"
    },
    "delta": {
      "exclusiveMinimum": 0,
      "title": "Delta",
      "type": "number"
    },
    "loss": {
      "$ref": "#/$defs/LossName"
    },
    "max_boundary_mass": {
      "default": 0.15,
      "maximum": 1,
      "minimum": 0,
      "title": "Max Boundary Mass",
      "type": "number"
    },
    "measurement_level": {
      "$ref": "#/$defs/MeasurementLevel",
      "default": "continuous"
    },
    "minimum_distinct_values": {
      "const": 5,
      "default": 5,
      "title": "Minimum Distinct Values",
      "type": "integer"
    },
    "minimum_standard_deviation": {
      "default": 1e-08,
      "minimum": 0,
      "title": "Minimum Standard Deviation",
      "type": "number"
    },
    "node_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "title": "Node Id",
      "type": "string"
    },
    "outcome_type": {
      "$ref": "#/$defs/OutcomeType"
    },
    "scale_max": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scale Max"
    },
    "scale_min": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scale Min"
    }
  },
  "required": [
    "node_id",
    "outcome_type",
    "loss",
    "delta"
  ],
  "title": "NodeSpec",
  "type": "object"
}
